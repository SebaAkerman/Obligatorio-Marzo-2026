    "exp_data = [{'Matchup': 'Expectimax(d=3) vs Minimax-AB(d=3)', 'Exp%': '4%'}, {'Matchup': 'Expectimax(d=4) vs Minimax-AB(d=3) [n=10]', 'Exp%': '50% (n=10)'}, {'Matchup': 'Expectimax(d=3) mirror match', 'Exp%': 'P1=70%'}]\n",
