  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 2. Torneos\n",
    "\n",
    "Enfrentamos los distintos agentes en 50 partidas a profundidad 3."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-04T16:31:45.215628Z",
     "iopub.status.busy": "2026-07-04T16:31:45.215567Z",
     "iopub.status.idle": "2026-07-04T16:52:18.243974Z",
     "shell.execute_reply": "2026-07-04T16:52:18.243577Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  Minimax-AB vs Random...\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  Expectimax vs Random...\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  Minimax-AB vs Expectimax...\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  Minimax(full) vs Minimax(mobility)...\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "                           Matchup  Agent1 wins  Agent2 wins Agent1 % Agent2 %\n",
      "              Minimax-AB vs Random           50            0     100%       0%\n",
      "              Expectimax vs Random           37           13      74%      26%\n",
      "          Minimax-AB vs Expectimax           49            1      98%       2%\n",
      "Minimax(full) vs Minimax(mobility)           35           15      70%      30%\n"
     ]
    }
   ],
   "source": [
    "DEPTH = 3\n",
    "N = 50\n",
    "\n",
    "matchups = [\n",
    "    ('Minimax-AB vs Random',\n",
    "     MinimaxAgent(1, DEPTH, eval_mobility_only, True), RandomAgent(2)),\n",
    "    ('Expectimax vs Random',\n",
    "     ExpectimaxAgent(1, DEPTH, eval_mobility_only), RandomAgent(2)),\n",
    "    ('Minimax-AB vs Expectimax',\n",
    "     MinimaxAgent(1, DEPTH, eval_mobility_only, True),\n",
    "     ExpectimaxAgent(2, DEPTH, eval_mobility_only)),\n",
    "    ('Minimax(full) vs Minimax(mobility)',\n",
    "     MinimaxAgent(1, DEPTH, eval_full, True),\n",
    "     MinimaxAgent(2, DEPTH, eval_mobility_only, True)),\n",
    "]\n",
    "\n",
    "tourn_results = []\n",
    "for name, a1, a2 in matchups:\n",
    "    print(f'  {name}...')\n",
    "    w = tournament(a1, a2, N)\n",
    "    tourn_results.append({\n",
    "        'Matchup': name, 'Agent1 wins': w[1], 'Agent2 wins': w[2],\n",
